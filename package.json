{
  "name": "fof",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "16.x"
  },
  "scripts": {
    "app": "yarn workspace client start",
    "start": "yarn workspace server start",
    "build": "yarn workspaces focus client server && yarn run build-app",
    "build-app": "yarn workspace client build",
    "build-server": "yarn workspace server build",
    "seed": "node server/script/seed.js",
    "start:concurrently": "concurrently --kill-others-on-fail \"yarn app\"  \"yarn start\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "main": "index.js",
  "repository": "git@github.com:hanna2895/politIQ.git",
  "author": "Hannah Werman <hanna.w28@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^7.0.0"
  },
  "packageManager": "yarn@3.2.0"
}
